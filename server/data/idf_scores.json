{
  "_source": "AG News Dataset (Zhang et al., 2015) - 120K news articles across 4 categories",
  "_technique": "IDF scores computed from AG News corpus. Words appearing in many documents get low IDF (common), rare words get high IDF (important)",
  "_formula": "IDF = log(N / df) where N=total docs, df=docs containing the word",
